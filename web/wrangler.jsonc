{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "load-organiser-web",
	"compatibility_date": "2026-11-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Staging (#161): served on the free *.workers.dev address; a custom domain comes
	// later. Pull-request preview URLs stay off: every build talks to the one API.
	"workers_dev": true,
	"preview_urls": false,
	// Variables are set in the Cloudflare dashboard (API_ORIGIN, APP_ORIGIN, and the
	// secret API_PROXY_KEY); keep_vars stops a deploy from erasing them. None is
	// declared here, so nothing in Git can overwrite them. Local preview passes them
	// with --var (scripts/dev.sh, playwright.config.ts). See src/env.ts and
	// docs/product/deploy-runbook.md.
	"keep_vars": true
}
