{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "load-organiser",
	"compatibility_date": "2026-11-02",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Staging (#161): served on the free *.workers.dev address; a custom domain comes
	// later. Pull-request preview URLs stay off: every build talks to the one API.
	"workers_dev": true,
	"preview_urls": false,
	// The staging origins are not secrets, so every deploy sets them from here (the
	// dashboard refused variables while the Worker still looked assets-only). Local
	// preview and the tests override them with --var (scripts/dev.sh,
	// playwright.config.ts). The one secret, API_PROXY_KEY, is set with
	// `npx wrangler secret put API_PROXY_KEY` and kept across deploys (keep_vars).
	// See src/env.ts and docs/product/deploy-runbook.md.
	"vars": {
		"APP_ORIGIN": "https://load-organiser.metalcorpe.workers.dev",
		"API_ORIGIN": "https://load-organiser.fastapicloud.dev"
	},
	"keep_vars": true
}
