{
	"name": "load-organiser-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "npm run types:check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173 --ip 127.0.0.1",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run types:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
		"gen": "node -e \"require('node:fs').rmSync('.svelte-kit/cloudflare',{recursive:true,force:true})\" && wrangler types --strict-vars=false",
		"contracts:generate": "openapi-ts",
		"storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
		"storybook:build": "storybook build -o storybook-static --quiet",
		"tokens:build": "style-dictionary build --config sd.light.json && style-dictionary build --config sd.dark.json",
		"test:unit": "vitest --run",
		"test:e2e": "npm run build && playwright test",
		"types:check": "node -e \"require('node:fs').rmSync('.svelte-kit/cloudflare',{recursive:true,force:true})\" && wrangler types --strict-vars=false --check"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@fontsource/figtree": "5.3.0",
		"@fontsource/outfit": "5.3.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@playwright/test": "1.65.0",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.7",
		"@storybook/addon-themes": "10.6.6",
		"@storybook/sveltekit": "10.6.6",
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/leaflet": "1.9.22",
		"@types/leaflet.markercluster": "1.5.6",
		"@types/node": "26.6.6",
		"colorjs.io": "0.7.1",
		"leaflet": "1.9.4",
		"leaflet.markercluster": "1.5.3",
		"storybook": "10.6.6",
		"style-dictionary": "5.7.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "8.3.6",
		"vitest": "5.1.0",
		"wrangler": "4.158.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261102.1": true
	},
	"overrides": {
		"js-yaml": "4.3.2"
	}
}
