            "title": "Checked At",
            "type": "string"
          },
          "database": {
            "description": "Whether the API could reach its database.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "status": {
            "description": "Overall API availability for beta requests.",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "checked_at"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "PasswordChangeIn": {
        "properties": {
