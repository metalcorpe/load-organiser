{
	"source": [
		"src/lib/design/tokens/shared.json",
		"src/lib/design/tokens/light.json"
	],
	"usesDtcg": true,
	"platforms": {
		"css": {
			"transformGroup": "css",
			"buildPath": "src/lib/design/",
			"files": [
				{
					"destination": "tokens-light.css",
					"format": "css/variables",
					"options": {
						"selector": ":root",
						"showFileHeader": false
					}
				},
				{
					"destination": "tokens-light-forced.css",
					"format": "css/variables",
					"options": {
						"selector": ":root[data-theme=\"light\"]",
						"showFileHeader": false
					}
				}
			]
		}
	}
}
